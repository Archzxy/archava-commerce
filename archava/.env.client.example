# Client profile: blank credentials; personal profile is never loaded.
# Server and worker only. Never put secrets in VITE_* or config/project.json.
PORT=5002
WEB_ORIGIN=http://localhost:5174
# Use a different ID for every project AND environment sharing LiveKit.
PROJECT_ID=archava-template-dev
# Empty = <PROJECT_ID>-host. API and worker must use the same name.
ARCHAVA_AGENT_NAME=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
# Source default; verify provider access before enabling sessions. Existing env wins.
# Rollback: gemini-2.5-flash-native-audio-preview-12-2025; compare: gemini-3.1-flash-live-preview.
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Empty preserves native Gemini VAD; tune only after a real voice comparison.
GEMINI_SILENCE_DURATION_MS=
# spatius | tavus | voice
AVATAR_PROVIDER=spatius
SPATIUS_API_KEY=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=
TAVUS_API_KEY=
FACE_ID=
PAL_ID=
# Public sessions stay off until credentials and the worker have been tested.
ENABLE_SESSIONS=false
# 0 = no fixed call deadline; Ava ends after a resolved task/goodbye. Optional: 30–1800.
SESSION_SECONDS=0
MAX_ACTIVE_SESSIONS=10
SESSION_STARTS_PER_MINUTE=3
# Off by default. Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Public build variable. Empty = same-origin /api (local proxy or single server).
# For Vercel + Railway set this to your public backend HTTPS origin, without /api.
VITE_API_BASE_URL=

# Optional checkout DEMO. Copy the Server Key from the Sandbox dashboard.
# It may start with SB-Mid-server- or Mid-server-; the API stays sandbox-only.
# Test ONLY in the official Midtrans simulator; never use a real bank/wallet app.
MIDTRANS_SERVER_KEY=
# Optional dedicated signing secret, same value in Node API and Python worker.
# Blank derives a purpose-separated key from LIVEKIT_API_SECRET. Never expose either.
CHECKOUT_SIGNING_KEY=

# Optional transactional receipt email. Configure a sender you control.
# The user confirms the recipient in the checkout card; it is not model context.
CHECKOUT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=true
# Cloud Run requires a private bucket with conditional-write permission.
# Local development defaults to the ignored encrypted .state/checkout-mail folder.
CHECKOUT_EMAIL_BUCKET=
CHECKOUT_EMAIL_STATE_DIR=
